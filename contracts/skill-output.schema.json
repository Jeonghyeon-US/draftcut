{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "videoedit:skill-output:1",
  "title": "Common Skill Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "output_id", "skill_id", "output_kind", "confidence", "scope", "impact", "evidence_ids", "dependencies", "backend_selections", "review"],
  "properties": {
    "schema_version": {"const": "1.0"}, "output_id": {"type": "string"}, "skill_id": {"type": "string"},
    "output_kind": {"enum": ["selection", "proposal", "constraint", "review", "failure"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "scope": {"type": "object", "additionalProperties": false, "required": ["source_id", "range"], "properties": {"source_id": {"type": "string"}, "range": {"$ref": "#/$defs/range"}}}, "impact": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["skill_id", "required", "on_missing"], "properties": {"skill_id": {"type": "string"}, "required": {"type": "boolean"}, "on_missing": {"enum": ["skip", "empty_result", "escalate_review"]}}}},
    "backend_selections": {"type": "array", "items": {"$ref": "#/$defs/backend_selection"}},
    "review": {"type": "object", "additionalProperties": false, "required": ["severity", "blocking", "state"], "properties": {"severity": {"enum": ["info", "warning", "critical"]}, "blocking": {"type": "boolean"}, "state": {"enum": ["open", "approved", "released"]}, "cost_approval": {"$ref": "#/$defs/cost_approval"}}},
    "failure": {"type": "object", "additionalProperties": false, "required": ["reason", "escalate_to_human"], "properties": {"reason": {"type": "string"}, "escalate_to_human": {"const": true}}}
  },
  "$defs": {
    "time": {"type": "object", "additionalProperties": false, "required": ["value", "timebase"], "properties": {"value": {"type": "integer"}, "timebase": {"type": "object", "additionalProperties": false, "required": ["num", "den"], "properties": {"num": {"type": "integer", "minimum": 1}, "den": {"type": "integer", "minimum": 1}}}}},
    "range": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"$ref": "#/$defs/time"}, "end": {"$ref": "#/$defs/time"}}},
    "backend_selection": {"type": "object", "additionalProperties": false, "required": ["purpose", "backend_id", "backend_version", "cost_tier"], "properties": {"purpose": {"enum": ["stt", "caption_renderer", "ocr", "shot_scene_boundary", "screen_activity"]}, "backend_id": {"type": "string", "minLength": 1}, "backend_version": {"type": "string", "minLength": 1}, "cost_tier": {"enum": ["무료-로컬", "쿼터", "유료"]}}},
    "cost_estimate": {"type": "object", "additionalProperties": false, "required": ["amount", "currency", "basis"], "properties": {"amount": {"type": "number", "minimum": 0, "maximum": 1000000}, "currency": {"type": "string", "minLength": 1}, "basis": {"type": "string", "minLength": 1}}},
    "cost_approval": {"type": "object", "additionalProperties": false, "required": ["call_id", "estimated_cost", "approved_by", "timestamp"], "properties": {"call_id": {"type": "string", "minLength": 1}, "estimated_cost": {"$ref": "#/$defs/cost_estimate"}, "approved_by": {"type": "string", "minLength": 1}, "timestamp": {"type": "string", "minLength": 1}}}
  }
}
